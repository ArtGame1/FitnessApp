<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ЗАГОЛОВОК -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#E53935"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🏋️ Админ панель"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Выход"
                android:backgroundTint="@color/red"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- 1. СТАТИСТИКА -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 Статистика"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="#E8F5E9"
                    android:layout_margin="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👤 Всего"
                        android:textSize="12sp"
                        android:textColor="#666" />
                    <TextView
                        android:id="@+id/tvTotalUsers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="#E3F2FD"
                    android:layout_margin="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏋️ Тренировки"
                        android:textSize="12sp"
                        android:textColor="#666" />
                    <TextView
                        android:id="@+id/tvTotalWorkouts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="#FFF3E0"
                    android:layout_margin="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👨‍🏫 Тренеры"
                        android:textSize="12sp"
                        android:textColor="#666" />
                    <TextView
                        android:id="@+id/tvTotalTrainers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#E65100" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="#F3E5F5"
                    android:layout_margin="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏢 Залы"
                        android:textSize="12sp"
                        android:textColor="#666" />
                    <TextView
                        android:id="@+id/tvTotalHalls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#6A1B9A" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 2. СПИСОК ПОЛЬЗОВАТЕЛЕЙ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👥 Пользователи"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="🔍 Поиск..."
                android:padding="12dp"
                android:background="@android:drawable/editbox_background"
                android:layout_marginBottom="8dp" />

            <ListView
                android:id="@+id/lvUsers"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:background="#FAFAFA" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnAddUser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Добавить"
                    android:textSize="9sp"
                    android:backgroundTint="@color/red"
                    android:textColor="@android:color/white"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnEditUser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Изменить"
                    android:textSize="9sp"
                    android:backgroundTint="@color/red"
                    android:textColor="@android:color/white"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnDeleteUser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Удалить"
                    android:textSize="9sp"
                    android:backgroundTint="@color/red"
                    android:textColor="@android:color/white"
                    android:layout_marginStart="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. УПРАВЛЕНИЕ ТРЕНИРОВКАМИ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏋️ Тренировки"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnManageWorkouts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Все тренировки"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/red"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnManageSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Расписание"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/red"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnManageTrainers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Преподаватели"
                android:backgroundTint="@color/red"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- 4. УПРАВЛЕНИЕ ЗАЛАМИ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏢 Залы"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnManageHalls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Управление залами"
                android:backgroundTint="@color/red"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- 5. АНАЛИТИКА -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📈 Аналитика"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginBottom="12dp" />

            <Spinner
                android:id="@+id/spinnerReports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnGenerateReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Сформировать отчет"
                android:backgroundTint="@color/red"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- 6. НАСТРОЙКИ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚙️ Настройки"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSystemSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Расширенные настройки"
                android:backgroundTint="@color/red"
                android:textColor="@android:color/white" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>